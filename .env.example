# Flask Configuration
SECRET_KEY=your_secure_random_key_here
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True

# Database Configuration (MySQL)
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=mahfooz_restaurant

# Set to True to allow fallback to SQLite if MySQL server is offline during initial test
ALLOW_SQLITE_FALLBACK=True

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CURRENCY=INR

# Direct Restaurant UPI ID (For Direct Scan & Pay QR)
RESTAURANT_UPI_ID=your_restaurant_upi_id@oksbi
RESTAURANT_UPI_NAME=MAHFOOZ RESTAURANT PATNA

